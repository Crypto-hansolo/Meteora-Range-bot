# ---------------------------------------------------------------- Solana
# A private RPC endpoint is strongly recommended; the public one rate-limits.
RPC_URL=https://api.mainnet-beta.solana.com
# Base58 secret key (Phantom export) or a JSON byte array (solana-keygen).
SOLANA_PRIVATE_KEY=
PRIORITY_FEE_MICRO_LAMPORTS=50000
TX_CONFIRM_TIMEOUT_MS=90000

# --------------------------------------------------------------- Meteora
METEORA_API_URL=https://dlmm-api.meteora.ag

# ----------------------------------------------------------- Hyperliquid
# Use an API/agent wallet, not your main key: it can trade but cannot withdraw.
HL_PRIVATE_KEY=
# Required only when HL_PRIVATE_KEY is an agent wallet — reads must target the
# master account that actually holds the positions.
HL_ACCOUNT_ADDRESS=
HL_TESTNET=false

# --------------------------------------------------------------- Capital
# USD value deposited into the LP position.
LP_CAPITAL_USD=1000
# Leave empty to let the liquidation-buffer math size the hedge margin.
HEDGE_COLLATERAL_USD=

# ------------------------------------------------------- Pool selection
# Set this to skip scanning and run one specific pool.
POOL_ADDRESS=
MIN_TVL_USD=250000
MAX_TVL_USD=500000000
MIN_VOLUME_24H_USD=200000
# Daily fees / TVL. 0.01 = the pool pays out 1% of its TVL in fees per day.
MIN_FEE_TVL_RATIO_24H=0.01
MIN_BIN_STEP=1
MAX_BIN_STEP=200
MIN_HL_OPEN_INTEREST_USD=2000000
POOL_BLACKLIST=
# Comma-separated symbols; empty means "any allowlisted token".
TOKEN_WHITELIST=
QUOTE_WHITELIST=USDC,USDT,SOL
# Only accept pools that need exactly one short (i.e. a stablecoin quote).
# A crypto/crypto pool like JUP/SOL carries delta on both sides and needs two
# perp positions: two margin buckets, two liquidation prices, correlated.
REQUIRE_STABLE_QUOTE=true
SCAN_LIMIT=10

# ------------------------------------------------------------ LP position
# Half-width of the range in percent around spot.
RANGE_WIDTH_PCT=5
# 70 bins fits a single non-extended DLMM position.
MAX_BINS=70
# Spot = uniform, Curve = concentrated at spot, BidAsk = concentrated at edges.
LP_STRATEGY=Spot
LP_SLIPPAGE_PCT=1

# ------------------------------------------------------------------ Hedge
# Leave empty to derive leverage from the liquidation buffer (recommended).
HEDGE_TARGET_LEVERAGE=
# Liquidation must sit this many times the upside range distance above spot.
HEDGE_LIQ_BUFFER_MULT=3
HEDGE_MIN_LIQ_BUFFER_PCT=25
HEDGE_MAX_LEVERAGE=10
# Re-hedge once the delta drift exceeds this share of the target notional.
HEDGE_REBALANCE_THRESHOLD_PCT=5
HEDGE_MIN_REBALANCE_USD=25
# Top up isolated margin when effective leverage exceeds this. Empty = off.
HEDGE_MARGIN_TOPUP_LEVERAGE=
HEDGE_SLIPPAGE_BPS=30
HEDGE_USE_ISOLATED_MARGIN=true

# ------------------------------------------------------------- Loop / risk
POLL_INTERVAL_MS=30000
REBALANCE_COOLDOWN_MS=60000
# Unwind after the price stayed outside the range this long. 0 = never.
EXIT_ON_OUT_OF_RANGE_MS=1800000
MAX_DRAWDOWN_PCT=15
CLAIM_FEES_INTERVAL_MS=3600000

# ---------------------------------------------------------------- Runtime
# Defaults to true. Set to false only when you intend to trade real money.
DRY_RUN=true
STATE_PATH=./data/state.json
LOG_LEVEL=info
# Extend the mint allowlist after verifying each mint address yourself:
# TOKEN_MAP_JSON={"<mint>":"SYMBOL"}
TOKEN_MAP_JSON=
